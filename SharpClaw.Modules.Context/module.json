{
  "id": "sharpclaw_context",
  "displayName": "SharpClaw Context",
  "version": "0.5.0-beta.23",
  "toolPrefix": "ctx",
  "runtime": "dotnet",
  "hostMode": "sidecar",
  "entryAssembly": "SharpClaw.Modules.Context.dll",
  "moduleType": "SharpClaw.Modules.Context.ContextModule",
  "minHostVersion": "0.5.0-beta.3",
  "author": "SharpClaw-NET",
  "description": "Threads, channels, contexts, conversation history, and context assembly.",
  "license": "AGPL-3.0-only",
  "enabled": true,
  "defaultEnabled": true,
  "exports": [
    {
      "contractName": "sharpclaw.context",
      "serviceType": "SharpClaw.Modules.AgentOrchestration.Contracts.ContextModuleContract",
      "optional": false
    }
  ],
  "requires": [
    {
      "contractName": "sharpclaw.permission",
      "serviceType": "SharpClaw.Modules.AgentOrchestration.Contracts.PermissionModuleContract",
      "optional": false
    }
  ],
  "requestedHooks": [
    {
      "target": "context.conversation.commit",
      "effects": ["Inspect", "Cancel"]
    },
    {
      "target": "permission.context-access",
      "effects": ["Inspect", "Wrap", "Observe"]
    }
  ]
}
