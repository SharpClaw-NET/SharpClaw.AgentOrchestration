<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Version>0.5.0-beta.17</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-beta.17</InformationalVersion>
    <NoWarn>$(NoWarn);CS9113;NU1507;NU1510;NETSDK1201</NoWarn>
    <SharpClawArtifactsRoot Condition="'$(SharpClawArtifactsRoot)' == ''">D:\temp\SharpClaw.AgentOrchestration\build</SharpClawArtifactsRoot>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(SharpClawArtifactsRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(SharpClawArtifactsRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**;$(SharpClawArtifactsRoot)\bin\**;$(SharpClawArtifactsRoot)\obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
