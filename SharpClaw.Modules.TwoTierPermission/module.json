{
  "id": "sharpclaw_two_tier_permission",
  "displayName": "SharpClaw Two Tier Permission",
  "version": "0.5.0-beta.1",
  "toolPrefix": "perm",
  "runtime": "dotnet",
  "hostMode": "sidecar",
  "entryAssembly": "SharpClaw.Modules.TwoTierPermission.dll",
  "moduleType": "SharpClaw.Modules.TwoTierPermission.TwoTierPermissionModule",
  "minHostVersion": "0.5.0-beta.1",
  "author": "SharpClaw-NET",
  "description": "Two-tier clearance, scope, denial, delegation, grant, and approval policy.",
  "license": "AGPL-3.0-only",
  "enabled": true,
  "defaultEnabled": true,
  "exports": [
    {
      "contractName": "sharpclaw.permission",
      "serviceType": "SharpClaw.Modules.AgentOrchestration.Contracts.PermissionModuleContract",
      "optional": false
    },
    {
      "contractName": "sharpclaw.context-access",
      "serviceType": "SharpClaw.Modules.AgentOrchestration.Contracts.IContextAccessPolicy",
      "optional": false
    },
    {
      "contractName": "sharpclaw.agent-access",
      "serviceType": "SharpClaw.Modules.AgentOrchestration.Contracts.IAgentAccessPolicy",
      "optional": false
    }
  ],
  "requestedHooks": [
    {
      "target": "permission.grant",
      "effects": ["Inspect", "Cancel"]
    }
  ]
}
